@{
	Layout = "_Layout";
	ViewBag.Avatar = Model.ProfileViewModel.ImageUrl;
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/izitoast/1.4.0/css/iziToast.css" integrity="sha512-DIW4FkYTOxjCqRt7oS9BFO+nVOwDL4bzukDyDtMO7crjUZhwpyrWBFroq+IqRe6VnJkTpRAS6nhDvf0w+wHmxg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" integrity="sha512-iecdLmaskl7CVkqkXNQ/ZH/XLlvWZOJyj7Yy7tcenmpD1ypASozpmT/E0iPtmFIB46ZmdtAc9eNBvH0H/ZpiBw==" crossorigin="anonymous" referrerpolicy="no-referrer" />
@model HomeControllerModel
<div class="sidebar-group left-sidebar chat_sidebar">

	<div id="chats" class="left-sidebar-wrap sidebar active slimscroll">
		<div class="slimscroll">

			<div class="left-chat-title d-flex justify-content-between align-items-center">
				<div class="chat-title">
					<h4>CHATS</h4>
				</div>
				<div class="add-section">
					<ul>
						<li>
							<a href="#" data-bs-toggle="modal" data-bs-target="#add-user">
								<i class="fa-solid fa-users-viewfinder"></i>
							</a>
						</li>
						<li>
							<a href="#" data-bs-toggle="modal" data-bs-target="#add-new-group">
								<i class="fas fa-plus"></i>
							</a>
						</li>
						<li class="list-inline-item dream_profile_menu" data-bs-toggle="tooltip"
							data-bs-placement="bottom" title="Profile">
							<a href="javascript:void(0)" class="btn btn-outline-light">
								<i class="fas fa-user"></i>
							</a>
						</li>

					</ul>
				</div>
			</div>

			<div class="search_chat has-search">
				<span class="fas fa-search form-control-feedback"></span>
				<input class="form-control chat_input" id="search-contacts" type="text"
					   placeholder="Search Contacts">
			</div>

			<div class="sidebar-body" id="chatsidebar">

				<div class="left-chat-title d-flex justify-content-between align-items-center ps-0 pe-0">
					<div class="chat-title">
						<h4>Recent Chats</h4>
					</div>
					<div class="add-section">
						<a href="#"><i class="fas fa-edit"></i></a>
					</div>
				</div>

				<ul class="user-list mt-2">
					@foreach (var chat in Model.ChatRooms)
					{
						<a href="/Home/LoadChats?roomId=@chat.Id">
						<li class="user-list-item">
							<div class="avatar avatar-online">
								<img src="~/assets/img/avatar/avatar-8.jpg" class="rounded-circle" alt="image">
							</div>
							<div class="users-list-body">
								<div>
									<h5>@chat.Name</h5>
										@if (chat.Messages != null)
										{
										<p>@chat.Messages!.Message1</p>
										}
										else
										{
										<p></p>
										}
								</div>
								<div class="last-chat-time">
										@if (chat.Messages != null)
										{
											@if (DateTime.Now.DayOfYear - @chat.Messages!.CreateDate.DayOfYear == 1)
											{
											<small class="text-muted">Yesterday</small>
											}
											else if (DateTime.Now.DayOfYear - @chat.Messages!.CreateDate.DayOfYear == 2)
											{
											<small class="text-muted">2 days ago</small>
											}
											else if (DateTime.Now.DayOfYear - @chat.Messages!.CreateDate.DayOfYear == 3)
											{
											<small class="text-muted">3 days ago</small>
											}
											else if (DateTime.Now.DayOfYear - @chat.Messages!.CreateDate.DayOfYear > 3)
											{
											<small class="text-muted">@chat.Messages!.CreateDate.ToString("MMMM dd")</small>
											}
											else
											{
												int hours = DateTime.Now.Hour - @chat.Messages!.CreateDate.Hour;
												if (hours == 0)
												{
													int minutes = DateTime.Now.Minute - @chat.Messages!.CreateDate.Minute;
												<small class="text-muted">@minutes minutes ago</small>
												}
												else
												{
												<small class="text-muted">@hours hours ago</small>
												}
											}
										}
									<small class="text-muted"></small>
										@*<div class="new-message-count"></div>*@
								</div>
							</div>
						</li>
						</a>
					}

				</ul>
			</div>
		</div>
	</div>

</div>


<div class="chat" id="middle">
	<div class="slimscroll">
		<div class="chat-header">
			<div class="user-details">
				<div class="d-lg-none ms-2">
					<ul class="list-inline mt-2 me-2">
						<li class="list-inline-item">
							<a class="text-muted px-0 left_side" href="#" data-chat="open">
								<i class="fas fa-arrow-left"></i>
							</a>
						</li>
					</ul>
				</div>
				<figure class="avatar ms-1">
					@if (@Model.ChatRooms.Count > 0)
					{
						<img src="~/assets/img/avatar/avatar-8.jpg" class="rounded-circle" alt="image">
					}
				</figure>
				<div class="mt-1">
					@if (@Model.ChatRooms.Count > 0)
					{
						<h5>@Model.ChatRoomCurrentViewModel!.Name</h5>
						<small class="online">
							Online
						</small>
					}
				</div>
			</div>
			<div class="chat-options">
				<ul class="list-inline">
					<li class="list-inline-item" data-bs-toggle="tooltip" data-bs-placement="bottom"
						title="Search">
						<a href="javascript:void(0)" class="btn btn-outline-light chat-search-btn">
							<i class="fa-solid fa-share-from-square"></i>
						</a>
					</li>
					@*<li class="list-inline-item" data-bs-toggle="tooltip" data-bs-placement="bottom"
					title="Voice call">
					<a href="javascript:void(0)" class="btn btn-outline-light" data-bs-toggle="modal"
					data-bs-target="#voice_call">
					<i class="fas fa-phone-alt voice_chat_phone"></i>
					</a>
					</li>
					<li class="list-inline-item" data-bs-toggle="tooltip" data-bs-placement="bottom"
					title="Video call">
					<a href="javascript:void(0)" class="btn btn-outline-light" data-bs-toggle="modal"
					data-bs-target="#video_call">
					<i class="fas fa-video"></i>
					</a>
					</li>

					<li class="list-inline-item">
					<a class="btn btn-outline-light no-bg" href="#" data-bs-toggle="dropdown">
					<i class="fas fa-ellipsis-h"></i>
					</a>
					<div class="dropdown-menu dropdown-menu-end">
					<a href="#" class="dropdown-item dream_profile_menu">
					Archive <span>
					<i class="fas fa-archive"></i>
					</span>
					</a>
					<a href="#" class="dropdown-item">
					Muted <span class="material-icons">volume_off</span>
					</a>
					<a href="#" class="dropdown-item">
					Delete <span>
					<i class="far fa-trash-alt"></i>
					</span>
					</a>
					</div>
					</li>*@
				</ul>
			</div>
			@if (Model.ChatRooms.Count > 0 && Model.ChatRoomCurrentViewModel != null)
			{
				<div class="chat-search">
					<span class="fa-solid fa-share-from-square form-control-feedback"></span>
					<input type="text" name="chat-search" placeholder="Search Chats" class="form-control" value="@Model.ChatRoomCurrentViewModel.Id">
					<div class="close-btn-chat"><span class="material-icons">close</span></div>
				</div>
			}
		</div>
		<div class="chat-body">
			<div class="messages">
				@if ((@Model.ChatRooms.Count > 0) && Model.ChatRoomCurrentViewModel!.Messages! != null!)
				{
					@foreach (var message in Model.ChatRoomCurrentViewModel.Messages)
					{
						if (message.Sender.Equals(Model.ProfileViewModel.AccId))
						{
							<div class="chats chats-right">
								<div class="chat-content">
									<div class="message-content">
										@message.Message1
										<div class="chat-time">
											<div>
												<div class="time"><i class="fas fa-clock"></i> @message.CreateDate.ToString("hh:mm tt")</div>
											</div>
										</div>
									</div>
									<div class="chat-profile-name text-end">
										<h6></h6>
									</div>
								</div>
								<div class="chat-avatar">
									<img src="~/assets/img/avatar/avatar-12.jpg" class="rounded-circle dreams_chat"
										 alt="image">
								</div>
								<div class="chat-action-btns me-2">
									<div class="chat-action-col">
										<a class="#" href="#" data-bs-toggle="dropdown">
											<i class="fas fa-ellipsis-h"></i>
										</a>
										<div class="dropdown-menu dropdown-menu-end">
											<a href="#" class="dropdown-item dream_profile_menu">
												Copy <span>
													<i class="far fa-copy"></i>
												</span>
											</a>
											<a href="#" class="dropdown-item">
												Save <span class="material-icons">save</span>
											</a>
											<a href="#" class="dropdown-item">
												Forward <span>
													<i class="fas fa-share"></i>
												</span>
											</a>
											<a href="#" class="dropdown-item">
												Delete <span>
													<i class="far fa-trash-alt"></i>
												</span>
											</a>
										</div>
									</div>
									<div class="chat-read-col">
										<span class="material-icons">done_all</span>
									</div>
								</div>
							</div>
						}
						else
						{
							<div class="chats">
								<div class="chat-avatar">
									<img src="~/assets/img/avatar/avatar-8.jpg" class="rounded-circle dreams_chat"
										 alt="image">
								</div>
								<div class="chat-content">
									<div class="message-content">
										@message.Message1
										<div class="chat-time">
											<div>
												<div class="time"><i class="fas fa-clock"></i> @message.CreateDate.ToString("hh:mm tt")</div>
											</div>
										</div>
									</div>
									<div class="chat-profile-name">
										<h6></h6>
									</div>
								</div>
								<div class="chat-action-btns ms-3">
									<div class="chat-action-col">
										<a class="#" href="#" data-bs-toggle="dropdown">
											<i class="fas fa-ellipsis-h"></i>
										</a>
										<div class="dropdown-menu dropdown-menu-end">
											<a href="#" class="dropdown-item dream_profile_menu">
												Copy <span>
													<i class="far fa-copy"></i>
												</span>
											</a>
											<a href="#" class="dropdown-item">
												Save <span class="material-icons">save</span>
											</a>
											<a href="#" class="dropdown-item">
												Forward <span>
													<i class="fas fa-share"></i>
												</span>
											</a>
											<a href="#" class="dropdown-item">
												Delete <span>
													<i class="far fa-trash-alt"></i>
												</span>
											</a>
										</div>
									</div>
								</div>
							</div>
						}
					}
				}
			</div>
		</div>
	</div>
	@if (@Model.ChatRooms.Count > 0)
	{
		<div class="chat-footer">
			<form asp-action="CreateMessage" method="post">
				<div class="smile-col">
					<a href="#"><i class="far fa-smile"></i></a>
				</div>
				<div class="attach-col">
					<a href="#"><i class="fas fa-paperclip"></i></a>
				</div>
				<input type="text" class="form-control chat_form" asp-for="@Model.SendMessageViewModel.Message1" placeholder="Enter Message....." required>
				<input hidden value="@Model.ProfileViewModel.AccId" type="text" class="form-control chat_form" asp-for="@Model.SendMessageViewModel.SenderId" placeholder="Enter Message.....">
				<input hidden value="@Model.ChatRoomCurrentViewModel!.Id" type="text" class="form-control chat_form" asp-for="@Model.SendMessageViewModel.RoomId" placeholder="Enter Message.....">
				<div class="form-buttons">
					<button class="btn send-btn" type="submit">
						<span class="material-icons">send</span>
					</button>
				</div>
				<div class="specker-col">
					<a href="#"><span class="material-icons">settings_voice</span></a>
				</div>
			</form>
		</div>
	}
</div>


